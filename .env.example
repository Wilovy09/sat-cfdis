ADQUIERE_API=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# L18-09: was a real-looking 13-char value -- never a real password here, but if this
# value is or was ever used in a real environment, rotate it there.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DATABASE=adquiere
POSTGRES_CERT_PATH=/Users/computadora/Desktop/rds-ca-bundle.pem

# L18-25: only needed to run the test suite (tests/consistency_invariants.rs,
# tests/perf_budget.rs, tests/number_contract.rs) against a real test database -- each is a
# real RFC that already has the specific history that test needs (large history, zero
# plantilla, etc). Set from the test environment's own data, never a client RFC committed
# here.
TEST_RFC_PRUEBA=CHANGE_ME
TEST_RFC_GRANDE=CHANGE_ME
TEST_RFC_SIN_PLANTILLA=CHANGE_ME
TEST_RFC_SNAPSHOT_3=CHANGE_ME
TEST_RFC_SNAPSHOT_4=CHANGE_ME
TEST_RFC_SNAPSHOT_5=CHANGE_ME

HOST=0.0.0.0
PORT=8080

# L18-09: was "*" -- a placeholder, not the real value for any deployed environment.
ALLOWED_ORIGINS=https://CHANGE_ME.example.com
ALLOWED_METHODS=GET,POST,PUT,DELETE

PHP_BIN=php
PHP_CLI_PATH=/pulso-backend/php-cli/bin/cfdi-scraper
# L18-09: was "false" (disabled) by default -- the scraper's own comment says that's
# dev-only. With this off, CIEC/FIEL travel to the SAT without verifying who they're
# handed to. Defaults to verification ON; only ever set to false for local development.
VERIFY_SSL=true
BOXFACTURA_CONFIG_PATH=/pulso-backend/libs/sat-captcha-ai-model/model/configs.yaml

TEMPLATES_DIR=/pulso-backend/templates/**/*

S3_BUCKET=

# pm2 process name (pm2 start ... --name <this>) -- used to locate this app's log files
# for GET /api/v1/admin/logs (/root/.pm2/logs/<name>-{out,error}.log). Defaults to
# "pulso-backend" if unset.
PM2_APP_NAME=pulso-backend

# Shared secret that lets adquiere-logs call GET /api/v1/admin/logs without a
# per-environment admin JWT (a personal JWT from one environment's login has no
# corresponding admin row in another environment's DB -- see routes/logs.rs). Same value
# must be set here and in adquiere-logs' ADMIN_LOGS_KEY on every environment adquiere-logs
# aggregates. Unset = the bypass is disabled, only the per-user JWT path works.
ADMIN_LOGS_KEY=

# L18-03: signs and verifies every session token Pulso itself issues (Google login).
# REQUIRED -- at least 32 characters, no default. The server refuses to start otherwise.
# Never reuse the placeholder below in a real environment.
JWT_SECRET=CHANGE_ME_to_a_real_random_secret_at_least_32_chars_long

# L18-02: verifies a session token the Adquiere API issued (email register/login) --
# see services/session.rs for why this can't be the same value as JWT_SECRET above. Must
# match the Adquiere API's own JWT_SECRET exactly. Unset = tokens from that issuer are
# rejected (401), not trusted -- email-login sessions won't work until this is set.
ADQUIERE_JWT_SECRET=